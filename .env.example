# Provider selection: "azure" (default), "xai" (Grok models via xAI API), or "openrouter"
LLM_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=  # Leave empty to use Entra ID (DefaultAzureCredential)
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# User simulator (can be same as above or different deployment)
AZURE_OPENAI_USER_DEPLOYMENT=gpt-4o

# xAI (Grok) — set LLM_PROVIDER=xai to activate
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_DEPLOYMENT=grok-3
# Optionally use a cheaper model for the user simulator:
# XAI_USER_DEPLOYMENT=grok-3-mini

# OpenRouter — set LLM_PROVIDER=openrouter to activate
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Agent model (e.g. meta-llama/llama-3.3-70b-instruct, mistralai/mistral-7b-instruct)
OPENROUTER_DEPLOYMENT=meta-llama/llama-3.3-70b-instruct
# Optionally use a cheaper model for the user simulator (falls back to OPENROUTER_DEPLOYMENT):
# OPENROUTER_USER_DEPLOYMENT=meta-llama/llama-3.1-8b-instruct
